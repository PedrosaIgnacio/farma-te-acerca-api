# Supabase project settings → Database → Connection string
# Pooled (Supavisor transaction pooler, port 6543) — used by the app at runtime (PrismaService).
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used only for migrations (prisma.config.ts).
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# Supabase project settings → API
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_ANON_KEY="..."
# Service role key — server-side only, never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY="..."

PORT=3000
# Comma-separated list of allowed origins (the Vite dev server, plus prod frontend URL later).
CORS_ORIGIN="http://localhost:5173"
